rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Validates that any certificate written contains valid OpportunityX signature & schema
    function isValidCertificate(data, certId) {
      return data.certificate_id == certId
        && (data.recipient_name is string || data.recipient is string)
        && data.status in ['Valid', 'Revoked', 'Expired', 'Suspended']
        && data.digital_signature is string
        && data.digital_signature.size() >= 66
        && data.digital_signature.matches('^0x[0-9a-fA-F]{64}$');
    }

    // Certificates Collection: Public Read for verification, Cryptographically Validated Write
    match /certificates/{certificateId} {
      // Anyone in the world can read/verify a certificate
      allow read: if true;

      // Only validly formatted, digitally signed records can be created or updated
      allow create: if isValidCertificate(request.resource.data, certificateId);
      allow update: if isValidCertificate(request.resource.data, certificateId);

      // Deletion restricted to authenticated admin
      allow delete: if request.auth != null;
    }

    // System Settings: Restricted Access
    match /settings/{settingId} {
      allow read, write: if request.auth != null;
    }

    // Biometric Passkeys / 2FA Storage: Restricted Access
    match /passkeys/{passkeyId} {
      allow read, write: if request.auth != null;
    }
  }
}
